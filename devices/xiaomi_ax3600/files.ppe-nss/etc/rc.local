#!/bin/sh
# Preserve the SSH moduli hardening from the previous AX3600 image.
# Filter only when a weak group is actually present; after the first boot
# the filtered file is already the input on subsequent boots.
if awk '$5 < 3071 { found = 1 } END { exit !found }' /etc/ssh/moduli; then
	awk '$5 >= 3071' /etc/ssh/moduli > /etc/ssh/moduli.safe
	mv /etc/ssh/moduli.safe /etc/ssh/moduli
fi

exit 0
