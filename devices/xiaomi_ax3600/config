#
# Xiaomi AX3600 (IPQ8071A, 512 MB) — custom PPE-NSS build.
#
# Concatenated onto devices/common/config by prepare-build.sh.

CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

## QCA9887 PCIe radio — the AX3600 uses its third radio for IoT.
## Include driver and firmware in the image, not only in the kmod feed.
CONFIG_ATH10K-CT_LEDS=y
CONFIG_PACKAGE_ath10k-board-qca9887=y
CONFIG_PACKAGE_ath10k-firmware-qca9887=y
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y

## Hardware this board does not have; keep its module in the build feed.
CONFIG_PACKAGE_kmod-phy-aquantia=m

## Polish LuCI
CONFIG_LUCI_LANG_pl=y

## WireGuard userspace and LuCI protocol support
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

## Policy Based Routing
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_pbr=y
CONFIG_PACKAGE_luci-app-pbr=y

## Adblock
CONFIG_PACKAGE_adblock=y
CONFIG_PACKAGE_luci-app-adblock=y

## Statistics and graphs
CONFIG_PACKAGE_luci-app-statistics=y
CONFIG_PACKAGE_collectd=y
CONFIG_PACKAGE_collectd-mod-cpu=y
CONFIG_PACKAGE_collectd-mod-memory=y
CONFIG_PACKAGE_collectd-mod-load=y
CONFIG_PACKAGE_collectd-mod-interface=y
CONFIG_PACKAGE_collectd-mod-network=y
CONFIG_PACKAGE_collectd-mod-thermal=y
CONFIG_PACKAGE_collectd-mod-wireless=y
CONFIG_PACKAGE_collectd-mod-uptime=y
CONFIG_PACKAGE_collectd-mod-df=y
CONFIG_PACKAGE_collectd-mod-rrdtool=y

## Utilities
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_wget-ssl=y

## devmem for low-level diagnostics
CONFIG_KERNEL_DEVMEM=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_DEVMEM=y
