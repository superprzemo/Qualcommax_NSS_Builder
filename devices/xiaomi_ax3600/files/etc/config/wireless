# AX3600 wireless layout adapted from the existing router configuration.
# All APs are disabled and keys are blank in the public build; set passwords
# after first boot from LuCI or UCI. Radio paths and RF settings are retained.

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi'
	option band '5g'
	option channel '44'
	option htmode 'HE80'
	option country 'US'
	option txpower '30'
	option cell_density '0'

config wifi-iface 'default_radio0'
	option device 'radio0'
	option network 'lan'
	option mode 'ap'
	option disabled '1'
	option ssid 'makapaka 5G'
	option encryption 'psk2'
	option key ''
	option wnm_sleep_mode '1'
	option ieee80211k '1'
	option time_advertisement '2'
	option bss_transition '1'
	option proxy_arp '1'

config wifi-device 'radio1'
	option type 'mac80211'
	option path 'platform/soc@0/c000000.wifi+1'
	option band '2g'
	option channel '1'
	option htmode 'HE20'
	option country 'US'
	option txpower '30'
	option cell_density '0'
	option legacy_rates '1'

config wifi-iface 'default_radio1'
	option device 'radio1'
	option network 'lan'
	option mode 'ap'
	option disabled '1'
	option ssid 'makapaka'
	option encryption 'psk2'
	option key ''
	option time_advertisement '2'

config wifi-device 'radio2'
	option type 'mac80211'
	option path 'soc@0/20000000.pcie/pci0000:00/0000:00:00.0/0000:01:00.0'
	option band '2g'
	option channel '6'
	option htmode 'HT20'
	option country 'US'
	option txpower '30'
	option cell_density '0'

config wifi-iface 'default_radio2'
	option device 'radio2'
	option network 'lan'
	option mode 'ap'
	option disabled '1'
	option ssid 'iot'
	option encryption 'psk2'
	option key ''
