      - name: Enable ATH10K QCA9887
        working-directory: openwrt
        run: |
          set -euo pipefail

          echo "===== BEFORE DEFCONFIG ====="
          grep -E 'CONFIG_PACKAGE_(kmod-ath10k|ath10k)' .config || true

          echo "===== ADD ATH10K ====="
          cat >> .config <<'EOF'
          CONFIG_PACKAGE_kmod-ath10k=y
          CONFIG_PACKAGE_ath10k-firmware-qca9887=y
          EOF

          make defconfig

          echo "===== AFTER DEFCONFIG ====="
          grep -E 'CONFIG_PACKAGE_(kmod-ath10k|ath10k)' .config || true

          echo "===== ATH10K PACKAGES ====="
          grep -R "Package/kmod-ath10k\|Package/ath10k-firmware-qca9887" \
            package feeds 2>/dev/null | head -50 || true
